#!/usr/bin/env bash
set -uo pipefail
fail=0; pass(){ printf '[PASS] %s\n' "$1"; }; bad(){ printf '[FAIL] %s\n' "$1" >&2; fail=1; }
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
for c in asar bsnes-plus python3 Xvfb openbox x11vnc sleep supervisord supervisorctl; do command -v "$c" >/dev/null && pass "$c available" || bad "$c unavailable"; done
mesen_backend=${MESEN_AGENT:-mesen-agent}
if mesen_path=$(command -v "$mesen_backend"); then
  pass 'mesen-agent available'
  expected=$(sed -n 's/^ARG MESEN_AGENT_COMMIT=//p' "$root/.devcontainer/Dockerfile" | head -1)
  revision_file=$(dirname "$mesen_path")/mesen-agent.revision
  if [[ -n "$expected" && -f "$revision_file" ]]; then
    actual=$(tr -d '[:space:]' < "$revision_file")
    [[ "$actual" == "$expected" ]] \
      && pass 'mesen-agent revision matches Dockerfile' \
      || bad "mesen-agent revision mismatch: installed ${actual:-unknown}, expected $expected"
  fi
else
  if [[ -n ${MESEN_AGENT:-} ]]; then
    bad "mesen-agent configured by MESEN_AGENT is unavailable: $MESEN_AGENT"
  else
    bad 'mesen-agent unavailable; this container may predate its Dockerfile installation -- rebuild the devcontainer'
  fi
fi
for c in snes-rom-info snes-offset snes-hexdump snes-verify snes-run snes-debug snes-automate snes-desktop snes-tiles snes-tile-scan snes-fidelity snes-disassemble snes-workstation dbz-kakusei-scenario dbz-kakusei-glyphs dbz-kakusei-translate; do "$root/tools/bin/$c" --help >/dev/null 2>&1 && pass "$c --help" || bad "$c --help"; done
[[ $("$root/tools/bin/snes-offset" --mapping lorom 02:8000) == 0x10000 ]] && pass 'LoROM conversion' || bad 'LoROM conversion'
[[ $("$root/tools/bin/snes-offset" --mapping hirom C1:2345) == 0x12345 ]] && pass 'HiROM conversion' || bad 'HiROM conversion'
PYTHONPATH="$root/toolkit" python3 -m unittest discover -s "$root/tests/toolkit" -v >/dev/null && pass 'generic toolkit tests' || bad 'generic toolkit tests'
# Byte-fidelity and disassembly are exercised against a synthetic ROM, so the
# environment validates itself without requiring a user-supplied ROM.
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
python3 - "$tmp/synthetic.sfc" <<'PY'
import sys
# Two LoROM banks with a valid internal header, so Asar will accept the image.
data = bytearray(0x10000)
state = 0x1234
for i in range(0x8000, 0x10000):
    state = (state * 1103515245 + 12345) & 0xFFFFFFFF
    data[i] = (state >> 16) & 0xFF
# Executable reset fixture: write two known WRAM bytes, then loop at $00:800D.
data[0:15] = bytes([
    0x78, 0xD8,             # SEI; CLD
    0xA9, 0x42,             # LDA #$42
    0x8D, 0x10, 0x00,       # STA $0010 (WRAM mirror -> $7E:0010)
    0xA9, 0xA5,             # LDA #$A5
    0x8F, 0x34, 0x12, 0x7E, # STA $7E1234
    0x80, 0xFE,             # BRA $800D
])
h = 0x7FC0
# NB: the title field is exactly 21 bytes. Assigning a shorter sequence to a
# 21-byte slice resizes the bytearray and silently truncates the ROM.
data[h:h+21] = b"SELFTESTROM".ljust(21, b"\x00")
data[h + 0x15] = 0x20  # LoROM, slow ROM
data[h + 0x17] = 0x02  # ROM size code: 128 KiB. Asar trusts this, and rejects
                     # reads past it with Esnes_address_out_of_bounds.
data[h + 0x3C:h + 0x3E] = (0x8000).to_bytes(2, "little")
ck = sum(data) & 0xFFFF
data[h + 0x1C:h + 0x1E] = (ck ^ 0xFFFF).to_bytes(2, "little")
data[h + 0x1E:h + 0x20] = ck.to_bytes(2, "little")
assert len(data) == 0x10000, f"fixture resized to {len(data)}"
open(sys.argv[1], "wb").write(bytes(data))
PY
"$root/tools/bin/snes-fidelity" "$tmp/synthetic.sfc" >/dev/null \
  && pass 'byte-faithful round trip on synthetic ROM' \
  || bad 'byte-faithful round trip on synthetic ROM'
if "$root/tools/bin/snes-disassemble" "$tmp/synthetic.sfc" --outdir "$tmp/dis" --bank 1 >/dev/null 2>&1 \
   && grep -q 'CODE_018000' "$tmp"/dis/bank01_01_65816.asm; then
    pass '65816 disassembly of synthetic ROM'
else
    bad '65816 disassembly of synthetic ROM'
fi
if "$root/tools/bin/snes-tile-scan" "$tmp/synthetic.sfc" --offset 0x8000 --count 8 --bpp 4 -o "$tmp/tiles" >/dev/null 2>&1 \
   && [ -s "$tmp/tiles/off008000_4bpp.png" ]; then
    pass 'tile contact sheet from synthetic ROM'
else
    bad 'tile contact sheet from synthetic ROM'
fi
capture="$tmp/automation-capture"
breakpoint="$tmp/automation-breakpoint"
if "$root/tools/bin/snes-automate" "$tmp/synthetic.sfc" \
     --artifact-dir "$capture" --frames 1 --timeout 10 \
     --list-memory --screenshot --state-json >/dev/null \
   && "$root/tools/bin/snes-automate" "$tmp/synthetic.sfc" \
     --artifact-dir "$breakpoint" --frames 100 --timeout 10 \
     --breakpoint 'SnesMemory:0x00800D:x' \
     --read-memory 'SnesWorkRam:0x10:1' \
     --read-memory 'SnesWorkRam:0x1234:1' \
     --pc --trace >/dev/null \
   && python3 - "$capture" "$breakpoint" <<'PY'
import json
import pathlib
import sys

capture = pathlib.Path(sys.argv[1])
breakpoint = pathlib.Path(sys.argv[2])
capture_events = [json.loads(line) for line in (capture / "events.jsonl").read_text().splitlines()]
break_events = [json.loads(line) for line in (breakpoint / "events.jsonl").read_text().splitlines()]
capture_metadata = json.loads((capture / "metadata.json").read_text())
break_metadata = json.loads((breakpoint / "metadata.json").read_text())
loaded = next(event for event in capture_events if event.get("event") == "loaded")
spaces = {event["type"] for event in capture_events if event.get("event") == "memory_space"}
reads = {
    (event["type"], event["start"]): event["hex"]
    for event in break_events if event.get("event") == "memory_read"
}
pc = next(event["value"] for event in break_events if event.get("event") == "program_counter")
assert loaded["console"] == "Snes" and loaded["cpu"] == "Snes"
assert {"SnesMemory", "SnesPrgRom", "SnesWorkRam", "SnesVideoRam", "SnesRegister"} <= spaces
assert reads[("SnesWorkRam", 0x10)] == "42"
assert reads[("SnesWorkRam", 0x1234)] == "a5"
assert pc == 0x00800D
assert capture_events[-1]["ok"] and capture_events[-1]["reason"] == "frame_limit"
assert break_events[-1]["ok"] and break_events[-1]["reason"] == "debugger_break"
assert capture_metadata["trustworthy"] and break_metadata["trustworthy"]
assert (capture / "frame.png").read_bytes().startswith(b"\x89PNG\r\n\x1a\n")
assert (capture / "state.json").stat().st_size > 0
assert (breakpoint / "trace.log").stat().st_size > 0
PY
then
    pass 'headless SNES automation on synthetic ROM'
else
    bad 'headless SNES automation on synthetic ROM'
fi
if "$root/tools/bin/snes-repo-audit" >/dev/null; then pass 'repository source audit'; else bad 'repository source audit'; fi
(( fail == 0 )) && echo 'Environment OK' || { echo 'Environment has failures' >&2; exit 1; }
