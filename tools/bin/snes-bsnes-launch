#!/usr/bin/env bash
set -euo pipefail

[[ $# -ge 1 ]] || { echo 'usage: snes-bsnes-launch COMMAND [BSNES_PLUS_ARGS...]' >&2; exit 2; }
command_name=$1
shift

# Resolve the real emulator while skipping this directory: tools/bin also holds a
# `bsnes-plus` shim that routes direct invocations through this launcher, so a
# plain PATH lookup would recurse.
self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
filtered_path=
IFS=: read -r -a path_entries <<<"${PATH:-}"
for entry in "${path_entries[@]}"; do
  [[ -n $entry && -d $entry ]] || continue
  [[ $(cd "$entry" && pwd -P) == "$self_dir" ]] && continue
  filtered_path=${filtered_path:+$filtered_path:}$entry
done
emulator=$(PATH=$filtered_path command -v bsnes-plus) || {
  echo "$command_name: bsnes-plus executable not found on PATH" >&2
  exit 127
}

config=${BSNES_CONFIG:-${HOME:?}/.bsnes/bsnes-qt.cfg}
if [[ -f $config ]] && grep -q '^system\.video = "None"' "$config"; then
  sed -i \
    -e 's/^system\.video = "None"/system.video = "OpenGL"/' \
    -e 's/^system\.crashedOnLastRun = true/system.crashedOnLastRun = false/' \
    "$config"
  echo "$command_name: restored bsnes-plus OpenGL video output after disabled-driver recovery" >&2
fi

# bsnes-plus relies on audio output or vertical blanking to pace emulation.  The
# managed Xvfb desktop has neither, so cap GLX frame presentation with a small
# monotonic-clock preload shim.  Set BSNES_UNTHROTTLED=1 for intentional maximum
# speed, or BSNES_FRAME_HZ to select a different cap (for example 50 for PAL).
if [[ ${BSNES_UNTHROTTLED:-0} != 1 ]]; then
  root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
  source_file=$root/tools/bsnes-glx-throttle.c
  cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/snes-workstation
  throttle=$cache_dir/bsnes-glx-throttle.so
  mkdir -p "$cache_dir"
  if [[ ! -f $throttle || $source_file -nt $throttle ]]; then
    temporary=$throttle.tmp.$$
    trap 'rm -f "$temporary"' EXIT
    cc -shared -fPIC -O2 -Wall -Wextra \
      -o "$temporary" "$source_file" -ldl -pthread
    mv "$temporary" "$throttle"
    trap - EXIT
  fi
  export LD_PRELOAD="$throttle${LD_PRELOAD:+:$LD_PRELOAD}"
fi

exec "$emulator" "$@"