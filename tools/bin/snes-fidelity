#!/usr/bin/env python3
"""Rebuild a ROM from its own bytes and report whether the result matches.

This is the byte-identical guarantee described in .clinerules section 2. It
makes no claims about the disassembly being semantically correct; it only proves
that every byte survives a round trip through the Asar assembly pipeline.

    snes-fidelity ROM                 # print MATCH or MISMATCH
    snes-fidelity ROM --keep          # also retain banks/ and faithful.asm
    snes-fidelity ROM --mapping hirom # override detected mapping
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "toolkit"))

from snesworkbench.asmbuild import rebuild_faithful  # noqa: E402
from snesworkbench.errors import WorkstationError  # noqa: E402
from snesworkbench.rom import detect_mapping  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="snes-fidelity", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("rom", type=Path, help="ROM to round-trip")
    parser.add_argument(
        "--mapping", choices=("lorom", "hirom"),
        help="override the detected memory mapping",
    )
    parser.add_argument(
        "--keep", action="store_true",
        help="keep the generated banks/ directory and faithful.asm for inspection",
    )
    parser.add_argument(
        "--workdir", type=Path,
        help="scratch directory (default: a temporary directory)",
    )
    args = parser.parse_args()

    if not args.rom.is_file():
        parser.error(f"ROM not found: {args.rom}")

    try:
        raw = args.rom.read_bytes()
        mapping = args.mapping or detect_mapping(raw)[0]
        workdir = args.workdir
        if workdir is None and args.keep:
            workdir = ROOT / "build" / "fidelity"
        rebuilt = rebuild_faithful(
            args.rom,
            mapping=mapping,
            workdir=workdir,
            comment_header=(
                f"Byte-faithful assembly of {args.rom.name}\n"
                f"mapping: {mapping}  size: {len(raw)} bytes\n"
                "Generated by tools/bin/snes-fidelity. Every byte is embedded\n"
                "verbatim; this file proves assembly fidelity, not disassembly quality."
            ),
        )
    except (OSError, WorkstationError, ValueError) as error:
        print(f"snes-fidelity: {error}", file=sys.stderr)
        return 1

    if args.keep:
        print(f"Kept assembly sources in {workdir}", file=sys.stderr)

    if len(rebuilt) != len(raw):
        print(
            f"MISMATCH: rebuilt is {len(rebuilt)} bytes, original is {len(raw)}",
            file=sys.stderr,
        )
        return 1

    first = next((i for i, (a, b) in enumerate(zip(raw, rebuilt)) if a != b), -1)
    if first >= 0:
        print(f"MISMATCH: first difference at file offset 0x{first:06X}", file=sys.stderr)
        return 1

    print("MATCH")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())