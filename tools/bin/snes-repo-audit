#!/usr/bin/env python3
"""Reject prohibited ROM-derived or generated material from repository source."""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "toolkit"))

from snesworkbench.repo_policy import audit_repository  # noqa: E402


def main() -> int:
    failures = audit_repository(ROOT)
    if failures:
        print("Repository policy audit failed:", file=sys.stderr)
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        return 1
    print("Repository policy audit passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
