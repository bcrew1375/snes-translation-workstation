#!/usr/bin/env python3
import argparse,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[2]; sys.path.insert(0,str(ROOT/'toolkit'))
from snesworkbench.graphics import decode_tiles,render_tiles
p=argparse.ArgumentParser(); p.add_argument('rom'); p.add_argument('offset',type=lambda x:int(x,0)); p.add_argument('--count',type=int,default=256); p.add_argument('--bpp',type=int,choices=(2,4,8),default=4); p.add_argument('-o','--output',default='build/tiles.png'); a=p.parse_args(); d=Path(a.rom).read_bytes(); stride=8*a.bpp; tiles=decode_tiles(d[a.offset:a.offset+a.count*stride],a.bpp); out=Path(a.output); out.parent.mkdir(parents=True,exist_ok=True); render_tiles(tiles).save(out); print(out)
